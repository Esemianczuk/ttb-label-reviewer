# Production host example for Eric's workstation-backed demo.
#
# Copy to ~/.config/ttb-label-reviewer/compose-production.env with
# scripts/install-production-compose-service.sh. Do not commit the generated
# file because it contains a per-host demo token secret.

TTB_DOCKER_BIND_IP=0.0.0.0
TTB_DOCKER_API_PORT=8000
TTB_DOCKER_ACCELERATOR=cuda

TTB_API_LAN_MODE=1
TTB_API_CORS_ORIGINS=https://esemianczuk.github.io,https://demo.sherpa-map.com,http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5174,http://localhost:5174
TTB_COORDINATOR_URL=https://demo.sherpa-map.com
VITE_TTB_BACKEND_URL=https://demo.sherpa-map.com
VITE_BASE_PATH=./

TTB_WORKER_CONCURRENCY=auto
TTB_WORKER_STALE_SECONDS=180
TTB_SEED_DEMO=1

# Generated by install script on the production host.
TTB_DEMO_TOKEN_SECRET=replace-me-with-a-generated-secret
