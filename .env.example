# Optional local overrides for Docker Compose and launch scripts.
# Copy to .env only when you need to override defaults.

# Backend HTTP port exposed on localhost.
TTB_DOCKER_API_PORT=8000
TTB_DOCKER_BIND_IP=127.0.0.1

# Docker launcher accelerator policy: auto, cpu, cuda, gpu, or container on macOS.
TTB_DOCKER_ACCELERATOR=auto

# Native launcher Paddle runtime: cpu or cuda.
# CUDA uses requirements-cuda-cu126.txt and is intended for Linux hosts with
# compatible NVIDIA drivers. Docker CUDA is the recommended GPU path.
TTB_PADDLE_RUNTIME=cpu

# Worker concurrency. Leave auto unless you are benchmarking.
TTB_WORKER_CONCURRENCY=auto

# Keep the browser closed after startup when running on a server.
TTB_NO_OPEN=0

# Bind the backend to localhost by default. Use 0.0.0.0 only on a trusted LAN.
TTB_API_HOST=127.0.0.1
TTB_API_PORT=8000

# Frontend builds use localhost by default. When the console is served by the
# FastAPI backend on a public domain, it can use the same origin automatically.
VITE_TTB_BACKEND_URL=http://127.0.0.1:8000
VITE_BASE_PATH=/
